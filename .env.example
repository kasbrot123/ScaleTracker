# Pflicht: Passwort für den Login (mindestens 8 Zeichen)
APP_PASSWORD=bitte-aendern

# Port auf dem Server
SCALETRACKER_PORT=3003
TZ=Europe/Berlin

# Legt beim ersten Start erfundene Daten an, wenn die Datenbank leer ist
SEED_DEMO=true

# Nur hinter einem HTTPS-Reverse-Proxy auf true setzen
COOKIE_SECURE=false
TRUST_PROXY=false
